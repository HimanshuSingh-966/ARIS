# Copy to .env and fill in your values.
#
# Every variable below is read by code in this repo — verified against the source,
# not inherited from an older revision. Three that used to live here were removed
# because nothing reads them:
#   LLM_PROVIDER    — rag/llm.py always uses Gemini, with a Groq fallback
#   POSTGRES_URL    — Supabase is reached over its REST client, never raw Postgres
#   API_SECRET_KEY  — never referenced; ARIS_API_KEY below is the real auth secret
#   SUPABASE_ANON_KEY — no code path uses it, and the browser holds no Supabase
#                       credentials at all (see ARIS_API_KEY)

# ── API access control ────────────────────────────────────────────────────────
# Shared secret between the Vercel Edge proxy and this backend. api/deps.py fails
# CLOSED: if this is unset, every protected endpoint answers 503 rather than
# allowing anonymous access. /health stays open for Render's probe.
#
# Set the SAME value in two places:
#   * Render (backend)  → ARIS_API_KEY
#   * Vercel (frontend) → ARIS_API_KEY  + ARIS_API_ORIGIN
# The browser never receives it — frontend/api/[...path].js injects it server-side.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ARIS_API_KEY=generate_a_long_random_value

# Comma-separated exact origins allowed by CORS. No wildcards: api/main.py rejects
# '*', and Starlette matches origins by exact string so "https://*.vercel.app"
# never matched anything. Vercel preview deploys are handled by a regex in
# api/main.py, not here.
ARIS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Rate limits (optional — these are the defaults). Window in seconds; the chat
# budget is separate and tighter because every call spends LLM tokens.
# ARIS_RATE_LIMIT_WINDOW=60
# ARIS_RATE_LIMIT_REQUESTS=120
# ARIS_CHAT_RATE_LIMIT_REQUESTS=15

# ── Vercel frontend only (set in the Vercel dashboard, not here) ──────────────
# Origin of the deployed backend, e.g. https://aris-api.onrender.com — read by the
# Edge proxy. It is deliberately NOT in the repo: keeping it out of vercel.json is
# what stops the backend URL being discoverable from the client bundle.
ARIS_API_ORIGIN=https://your-backend.onrender.com
#
# docker-compose sets this so the vite dev proxy can reach the api service by name;
# outside Docker the default (http://localhost:8000) is correct.
# ARIS_API_PROXY_TARGET=http://api:8000

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# Fallback, used only for quota / rate-limit / 5xx failures on Gemini.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Storage: Backblaze B2 over the S3-compatible API ─────────────────────────
B2_KEY_ID=your_keyID_here
B2_APP_KEY=your_applicationKey_here
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=pharma-rag-docs

# ── Database: Supabase ───────────────────────────────────────────────────────
# The service key bypasses RLS. It is server-side only — it must never be exposed
# to the browser, which is why vite.config.js restricts envPrefix to VITE_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here
