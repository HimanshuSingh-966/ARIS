# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.pytest_cache/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/

# setuptools / distutils build output. These are ANCHORED with a leading slash on
# purpose. A pattern like `lib/` with no leading slash matches a directory named
# `lib` at ANY depth — which silently excluded frontend/src/lib/api.js from the
# repo. Every component imports from that module, so the working tree built fine
# while a clean checkout (Vercel) could not resolve it at all. These names are
# only ever produced at the project root, so anchor them there.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/env/

# Node / frontend. Deliberately NOT anchored: node_modules is created wherever an
# install runs (repo root under Docker, frontend/ under a normal `npm install`),
# and unlike `lib/` above there is no legitimate source directory by this name.
node_modules/
frontend/dist/

# Vercel CLI state. `vercel pull` writes the project's PRODUCTION environment
# values — ARIS_API_KEY and ARIS_API_ORIGIN among them — to
# .vercel/.env.development.local. Committing that would put the backend's shared
# secret in the repo, defeating the entire point of the Edge proxy.
.vercel/
